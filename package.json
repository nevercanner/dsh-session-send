{
  "name": "dsh-session-send",
  "version": "0.3.0",
  "description": "DSH 会话总线：让同一项目内的独立会话按 session id 或自注册名互相发消息并唤醒对方，无需人工复制提示词。默认关闭，仅在存在 .dsh-bus.json 且 enabled=true 的项目内生效。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "assets/icon.svg",
  "license": "MIT",
  "author": "YG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevercanner/dsh-session-send.git"
  },
  "homepage": "https://github.com/nevercanner/dsh-session-send#readme",
  "bugs": {
    "url": "https://github.com/nevercanner/dsh-session-send/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "messaging",
    "agent-bus",
    "inter-session",
    "multi-agent",
    "cordis"
  ],
  "files": [
    "lib",
    "src",
    "types",
    "assets",
    "migrations",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  }
}
